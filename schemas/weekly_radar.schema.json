{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ruicore/ai-signal-radar/schemas/weekly_radar.schema.json",
  "title": "Weekly AI Signal Radar",
  "type": "object",
  "required": [
    "schema_version",
    "date",
    "title",
    "status",
    "source",
    "themes",
    "signals",
    "ideas",
    "markdown_path"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["reviewed"]
    },
    "reviewed_by": {
      "type": "string",
      "default": "Ray"
    },
    "source": {
      "type": "object",
      "required": ["generator", "reviewed_before_ingestion"],
      "properties": {
        "generator": {
          "type": "string",
          "default": "ChatGPT"
        },
        "reviewed_before_ingestion": {
          "type": "boolean",
          "const": true
        },
        "source_file": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "signals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/signal"
      }
    },
    "ideas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/idea"
      }
    },
    "markdown_path": {
      "type": "string",
      "pattern": "^radars/[0-9]{4}/[0-9]{4}-[0-9]{2}-[0-9]{2}\\.md$"
    },
    "raw_markdown": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "signal": {
      "type": "object",
      "required": ["title", "summary"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "idea": {
      "type": "object",
      "required": ["title", "summary"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    }
  }
}

