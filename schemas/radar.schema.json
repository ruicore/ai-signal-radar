{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ruicore/ai-signal-radar/schemas/radar.schema.json",
  "title": "Reviewed AI Signal Radar",
  "type": "object",
  "required": [
    "schema_version",
    "radar_type",
    "date",
    "title",
    "status",
    "source",
    "themes",
    "signals",
    "ideas",
    "markdown_path"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "2.0"},
    "radar_type": {"type": "string", "enum": ["systems", "creation"]},
    "date": {"type": "string", "format": "date"},
    "observation_window": {"$ref": "#/$defs/observation_window"},
    "title": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["reviewed"]},
    "reviewed_by": {"type": "string", "default": "Ray"},
    "source": {"$ref": "#/$defs/source"},
    "themes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "signals": {"type": "array", "items": {"$ref": "#/$defs/signal"}},
    "patterns": {"type": "array", "items": {"$ref": "#/$defs/pattern"}},
    "ideas": {"type": "array", "items": {"$ref": "#/$defs/idea"}},
    "markdown_path": {
      "type": "string",
      "pattern": "^radars/(systems|creation)/[0-9]{4}/[0-9]{4}-[0-9]{2}-[0-9]{2}\\.md$"
    },
    "raw_markdown": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"radar_type": {"const": "creation"}}},
      "then": {"required": ["observation_window"]}
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "observation_window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["generator", "reviewed_before_ingestion"],
      "properties": {
        "generator": {"type": "string", "default": "ChatGPT"},
        "reviewed_before_ingestion": {"type": "boolean", "const": true},
        "source_file": {"type": "string"}
      },
      "additionalProperties": false
    },
    "signal": {
      "type": "object",
      "required": ["title", "summary"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "themes": {"type": "array", "items": {"type": "string"}, "default": []},
        "evidence": {"type": "array", "items": {"type": "string"}, "default": []},
        "evidence_level": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "creator": {"type": "string", "minLength": 1},
        "what_was_created": {"type": "string", "minLength": 1},
        "what_ai_changed": {"type": "string", "minLength": 1},
        "human_behavior_change": {"type": "string", "minLength": 1},
        "transferable_idea": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "pattern": {
      "type": "object",
      "required": ["title", "summary", "outlook"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "outlook": {"type": "string", "minLength": 1},
        "themes": {"type": "array", "items": {"type": "string"}, "default": []},
        "examples": {"type": "array", "items": {"type": "string"}, "default": []}
      },
      "additionalProperties": false
    },
    "idea": {
      "type": "object",
      "required": ["title", "summary"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "themes": {"type": "array", "items": {"type": "string"}, "default": []}
      },
      "additionalProperties": false
    }
  }
}
